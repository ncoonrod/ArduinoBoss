<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ArduinoBoss.Client</RootNamespace>
		<AssemblyName>arduinoboss</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<!-- Cross-platform serial port access. On Linux this also pulls the libSerialPort backend. -->
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />
		<!-- Socket.IO v4 client (server uses HotStaq's socket.io transport). -->
		<PackageReference Include="SocketIOClient" Version="3.1.1" />
	</ItemGroup>

</Project>
