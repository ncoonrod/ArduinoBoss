{
  "name": "arduinoboss",
  "description": "",
  "version": "1.0.0",
  "main": "build/index.js",
  "scripts": {
    "start": "node ./build/cli.js --hotsite ./HotSite.json run --server-type web-api --api-http-port 8080 --web-http-port 8080 --ws",
    "develop": "node ./build/cli.js --hotsite ./HotSite.json --development-mode run --server-type web-api --api-http-port 8080 --web-http-port 8080 --ws",
    "test": "node ./build/cli.js --dev --env-file .env run --server-type api --api-test && node ./build/cli.js --dev --env-file .env run --server-type web --web-test",
    "build": "tsc --build ./tsconfig.json",
    "build-web": "node ./build/cli.js generate --api --generate-type javascript --copy-to ./public/js/",
    "build-web-debug": "node ./build/cli.js generate --api --generate-type javascript --copy-to ./public/js/",
    "build-doc": "node ./build/cli.js generate --generate-type openapi-3.0.0-yaml",
    "build-interfaces": "node ./build/cli.js build --interfaces --interfaces-out ./src/object-defs/"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "pkg": {
    "scripts": [
      "node_modules/selenium-webdriver/**/*.js"
    ]
  },
  "dependencies": {
    "dotenv": "^10.0.0",
    "hotstaq": "^0.9.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/formidable": "^3.4.5",
    "@types/fs-extra": "^9.0.12",
    "@types/js-cookie": "^2.2.7",
    "@types/mime-types": "^2.1.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.11.19",
    "@types/node-fetch": "^2.6.1",
    "@types/pg": "^8.11.10",
    "@types/pg-pool": "^2.0.6",
    "@types/selenium-webdriver": "^4.1.5",
    "@types/uuid": "^8.3.4",
    "ts-loader": "^7.0.5",
    "tslib": "^2.6.0",
    "typescript": "^6.0.3"
  }
}
